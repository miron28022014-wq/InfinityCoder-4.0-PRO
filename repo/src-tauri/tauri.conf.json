{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InfinityCoder",
  "version": "4.0.0",
  "identifier": "com.miron.infinitycoder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "InfinityCoder",
        "width": 1600,
        "height": 940,
        "minWidth": 1040,
        "minHeight": 660,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "decorations": true,
        "dragDropEnabled": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["bin/*"],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installMode": "currentUser",
        "languages": ["Russian", "English"]
      }
    },
    "copyright": "InfinityCoder",
    "category": "DeveloperTool",
    "shortDescription": "Автономный агентный IDE",
    "longDescription": "InfinityCoder — автономный агентный IDE с локальным ядром, памятью проекта и роем параллельных агентов."
  }
}
