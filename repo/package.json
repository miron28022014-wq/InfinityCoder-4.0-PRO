{
  "name": "infinitycoder",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "description": "InfinityCoder 4.0 — автономный агентный IDE с полной интеграцией Infinity Ecosystem (Core API, AI Runtime, Tool Runtime, Search, Memory, Sync)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "serve": "node scripts/serve-dist.cjs",
    "bridge": "node scripts/bridge.cjs",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "check": "tsc -b --noEmit && npm test && vite build",
    "ecosystem:build": "tsc -p ecosystem/tsconfig.json",
    "ecosystem:start": "node ecosystem/dist/server.js",
    "ecosystem:migrate": "node ecosystem/dist/cli/migrate.js",
    "screenshots": "node scripts/screenshots.mjs",
    "install:local": "bash scripts/install.sh",
    "install:windows": "powershell -ExecutionPolicy Bypass -File scripts/install.ps1",
    "screenshots:live": "node scripts/screenshots-live.mjs",
    "build:all": "npm run build && cd ecosystem && npm run build",
    "test": "tsx test/parse.test.mts && tsx test/ecosystem.test.mts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "puppeteer": "^25.16.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}